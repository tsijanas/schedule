rules_version = '2';

// ============================================================================
// Rota — access control
//
// Data model this protects:
//   - rota_kv/{docId}          the app's shared data (members, teams, schedules, holidays…)
//                               stored as single JSON blobs, one doc per key.
//   - access_control/approved  { uids: [...] }  the allow-list. Only uids in here get in.
//   - signup_requests/{uid}    one doc per person waiting on an admin, doc id == their own uid.
//
// The important idea: authentication (Firebase Auth) only proves *who* someone is.
// Whether they're allowed to see anything is decided here, not in index.html's JavaScript —
// a user can read/edit that JavaScript freely, but they cannot rewrite these rules.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors OWNER_EMAILS in index.html. Safe to hardcode: Firebase Auth verifies the email
    // on sign-in, so nobody but the real owner of this address can ever satisfy this check —
    // it's a guarantee for that one person, not a hole for anyone else. Keep this list short
    // and keep both copies (here and in index.html) in sync.
    function isOwner() {
      return isSignedIn() && request.auth.token.email in ['mrsijanas@gmail.com'];
    }

    function approvedUids() {
      return get(/databases/$(database)/documents/access_control/approved).data.uids;
    }

    function isApproved() {
      return isOwner() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/access_control/approved) && request.auth.uid in approvedUids())
          || exists(/databases/$(database)/documents/claimed_links/$(request.auth.uid))
        )
      );
    }

    // Kept in sync by the app (access_control/managers) with whoever currently holds the
    // Manager tag in app_members. This is what makes "only Managers can edit member data"
    // an actual server-side rule instead of just a hidden button in the UI.
    function isManagerUid() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/access_control/managers)
        && request.auth.uid in get(/databases/$(database)/documents/access_control/managers).data.uids;
    }

    // Narrower than isManagerUid: only a true org Admin. access_control/admins is kept in
    // sync by the app (see syncManagerRoster) with whoever holds the Admin role.
    function isAdminUid() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/access_control/admins)
        && request.auth.uid in get(/databases/$(database)/documents/access_control/admins).data.uids;
    }

    // The signed-in account's own email address, lowercased. Everything this app stores is
    // lowercased (see saveContact), but request.auth.token.email is whatever the identity
    // provider has on file — a Google account whose address is spelled with a capital letter
    // hands back that capital. Every comparison below goes through this, because an exact
    // comparison against the stored form silently locked such a person out of their own
    // record: their contact claim failed, so no claimed_links marker was written, so the rule
    // letting them set their own name never matched, and the app fell back to "couldn't save"
    // on every single login.
    function myEmail() {
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }
    function contactEmailOf(memberId) {
      return get(/databases/$(database)/documents/member_contacts/$(memberId)).data.email.lower();
    }
    // "Is this person's own record" — answered two independent ways, so one missing marker
    // can't lock somebody out of their own row: the claimed_links marker written when they
    // claimed their invite, or the contact record that already carries their auth uid.
    function isMyMemberRow(memberId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/claimed_links/$(request.auth.uid))
          && get(/databases/$(database)/documents/claimed_links/$(request.auth.uid)).data.memberId == memberId
        )
        || (
          exists(/databases/$(database)/documents/member_contacts/$(memberId))
          && 'authUid' in get(/databases/$(database)/documents/member_contacts/$(memberId)).data
          && get(/databases/$(database)/documents/member_contacts/$(memberId)).data.authUid == request.auth.uid
        )
      );
    }

    // ---- Input validation ----
    // Everything above answers "who can write here." These answer "is what they're writing
    // actually sane" — required fields present, correct types, reasonable length caps. This
    // matters because these rules are the real backend for this app: the client-side JS can be
    // bypassed entirely (anyone can call the Firestore SDK directly from a browser console),
    // so validation has to live here to mean anything, not just in index.html's form code.
    function isValidMember(d) {
      return d.name is string && d.name.size() <= 100
        && d.levels is list && d.levels.size() <= 10
        && (d.teamId == null || d.teamId is string)
        && (!('isAdmin' in d) || d.isAdmin is bool)
        && (!('role' in d) || d.role == null || d.role in ['admin','manager'])
        && (!('managerDeptId' in d) || d.managerDeptId == null || d.managerDeptId is string)
        && (!('birthday' in d) || d.birthday == null || (d.birthday is string && d.birthday.size() == 5))
        && d.eligibility is map;
    }
    function isValidHoliday(d) {
      return d.dates is list && d.dates.size() <= 400
        && d.reasons is map;
    }
    function isValidContact(d) {
      return d.email is string && d.email.size() <= 200
        && (d.authUid == null || (d.authUid is string && d.authUid.size() <= 128));
    }
    function isValidKv(d) {
      // Every rota_kv doc is a JSON-stringified blob under `value` — can't validate its inner
      // shape generically here (it differs per key: teams, tasks, schedules…), but can at
      // least ensure it's the right type and not absurdly large (Firestore's own hard cap is
      // 1MB per doc; this keeps individual writes well under that on purpose).
      return d.value is string && d.value.size() < 900000;
    }

    // ---- Proof of a self-claimed invite. When someone signs up with the same email an admin
    // already pre-entered for them (an "invite"), they claim it (see member_contacts self-claim
    // below) instead of being queued for approval. This doc is how that grants access: the
    // rule verifies the linked member_contacts record really does show this exact uid+email
    // before allowing the marker to be created — nobody can fabricate a claim for an invite
    // that isn't genuinely theirs, since get() below reads the real, already-written record.
    match /claimed_links/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isOwner() || isManagerUid() || (
        isSignedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/member_contacts/$(request.resource.data.memberId))
        && 'authUid' in get(/databases/$(database)/documents/member_contacts/$(request.resource.data.memberId)).data
        && get(/databases/$(database)/documents/member_contacts/$(request.resource.data.memberId)).data.authUid == request.auth.uid
        && 'email' in get(/databases/$(database)/documents/member_contacts/$(request.resource.data.memberId)).data
        && contactEmailOf(request.resource.data.memberId) == myEmail()
      );
      allow delete: if isOwner() || isManagerUid();
      allow update: if false;
    }

    // ---- Direct email -> memberId lookup, used only so login can find "does an invite exist
    // for this email" with a single, unambiguous document read instead of a collection query.
    // A query whose read rule depends on more than the filtered field can be rejected by
    // Firestore outright, even when the one matching document would itself be perfectly
    // readable — this index exists specifically to avoid depending on that working.
    match /email_index/{emailKey} {
      allow read: if isSignedIn();
      allow write: if isOwner() || isManagerUid();
    }

    // ---- Contact info (email, authUid), split out of app_members. Everyone approved can read
    // the roster (app_members) to see names/teams/schedules, but email addresses and the
    // technical auth-account link are Manager/owner-only — EXCEPT each person can look up their
    // own contact doc, constrained to a query on their own uid, which is how the app finds
    // "which member row is me" on login without needing broad read access. ----
    match /member_contacts/{memberId} {
      // An unclaimed record is one whose authUid is null OR absent entirely — older records
      // predate that field, and reading a key that isn't there is an evaluation error, which
      // denies the whole rule. Spelling both cases out is what keeps those records claimable.
      function isUnclaimedContact() {
        return !('authUid' in resource.data) || resource.data.authUid == null;
      }
      allow read: if isOwner() || isManagerUid()
        || (isSignedIn() && 'authUid' in resource.data && resource.data.authUid == request.auth.uid)
        || (isSignedIn() && isUnclaimedContact() && 'email' in resource.data && resource.data.email.lower() == myEmail());
      allow create: if (isOwner() || isManagerUid()) && isValidContact(request.resource.data);
      allow update: if isValidContact(request.resource.data) && (
        isOwner() || isManagerUid()
        || (
          // Self-claim: a signed-in person may claim an unclaimed record that matches their
          // own verified email, but only by setting authUid to exactly their own uid — the
          // email itself can't change, and nothing else about the record can be touched this way.
          isSignedIn()
          && isUnclaimedContact()
          && 'email' in resource.data
          && resource.data.email.lower() == myEmail()
          && request.resource.data.email == resource.data.email
          && request.resource.data.authUid == request.auth.uid
        )
      );
      allow delete: if isOwner() || isManagerUid();
    }

    // ---- The shared app data. Only people an admin has approved may read or write it. ----
    match /rota_kv/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved() && isValidKv(request.resource.data);
      allow delete: if isApproved();
    }

    // ---- Members, one doc per person (app_members/{memberId}) instead of one shared blob.
    // Reading your team's roster is fine for anyone approved (that's how schedules render for
    // everyone) — but WRITING someone's team/level/name now genuinely requires being a Manager
    // or the owner, enforced here, not just hidden behind a button in the UI.
    match /app_members/{memberId} {
      // Setting your own name, on your own row, and nothing else. Three things about this are
      // deliberate, and each of them was a way the previous version of this rule failed:
      //
      //  - It does NOT require the stored name to still be blank. That condition meant a name
      //    could be set exactly once and never corrected — and since the app now fills a name
      //    in from the email address, "once" had already been spent before anyone typed
      //    anything, leaving people permanently unable to fix their own name.
      //  - It does NOT require the whole document to pass isValidMember. A row saved by an
      //    older version of the app can be missing a field validation now insists on (most
      //    often eligibility), and that made every write of that row fail, including a write
      //    of nothing but the person's own name.
      //  - It identifies the row two ways (see isMyMemberRow), so a missing claimed_links
      //    marker alone can't make somebody's own record unwritable.
      //
      // It is still narrow: only the name key may change, it has to be a non-empty string
      // within the same length cap validation uses elsewhere, and team, level, role, admin
      // rights and eligibility remain Manager-only. Somebody can rename themselves on the
      // schedule, which is the point — a Manager can rename them back on the People tab.
      function isSelfNameUpdate() {
        return isMyMemberRow(memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
      }
      allow read: if isApproved();
      allow create: if (isOwner() || isManagerUid()) && isValidMember(request.resource.data);
      allow update: if ((isOwner() || isManagerUid()) && isValidMember(request.resource.data))
        || isSelfNameUpdate();
      allow delete: if isOwner() || isManagerUid();
    }

    // ---- Holidays, one doc per person (app_holidays/{memberId}). Anyone approved can read
    // (teams need to see each other's days off to coordinate) or write (marking your own days
    // off is self-service, same as it always was — this isn't Manager-gated). ----
    match /app_holidays/{memberId} {
      allow read: if isApproved();
      allow create, update: if isApproved() && isValidHoliday(request.resource.data);
      allow delete: if isApproved();
    }

    // ---- The manager roster. Bootstraps once, the same way access_control/approved does:
    // whoever's already approved when this collection doesn't exist yet may seed it (covers
    // both a brand-new install and the one-time migration of whoever already held the Manager
    // tag in app_members before this rule existed). After that, only an existing manager or
    // the owner may change it. ----
    match /access_control/managers {
      allow read: if isApproved();
      allow create: if isApproved() && !exists(/databases/$(database)/documents/access_control/managers);
      allow update: if (isOwner() || isManagerUid()) && request.resource.data.uids is list;
      allow delete: if false;
    }

    // ---- The allow-list itself. ----
    match /access_control/approved {
      // Bootstrap: if this document doesn't exist yet, nobody has ever been approved, which
      // means nobody could pass isApproved() to create it either — so the very first
      // authenticated user is allowed to create it (containing only themselves). This mirrors
      // the app's own "first person in becomes admin" bootstrap logic in index.html.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/access_control/approved)
        && request.resource.data.uids.size() == 1
        && request.resource.data.uids[0] == request.auth.uid;

      // Every signed-in user — including brand-new, not-yet-approved ones — has to be able
      // to read this list just to check "is my uid on it?" (that's how they find out whether
      // they're pending). So read only requires being signed in; it's just a list of uids,
      // nothing sensitive. Adding someone new to it (i.e. approving them) still requires the
      // caller to already be approved themselves.
      allow read: if isSignedIn();
      allow update: if isApproved() && request.resource.data.uids is list;
      allow delete: if false;
    }

    // ---- Pending signups: one doc per waiting account, keyed by that account's own uid. ----
    match /signup_requests/{uid} {
      // You may create only your own request, and only with these three fields — you cannot
      // pre-approve yourself, set a team, or claim to be someone else's uid.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.createdAt is number;

      // You can check your own pending status; approved users (admins) can see the queue.
      allow read: if isSignedIn() && (request.auth.uid == uid || isApproved());

      // Only an admin (via the approve-and-assign flow) removes a request, once that person
      // has been given a member record and added to the allow-list.
      allow delete: if isApproved();
      allow update: if false;
    }
    // ---- Audit log: append-only record of admin/write actions. Anyone approved can write an
    // entry, but only one describing their own uid as the actor — nobody can log an action as
    // someone else. Reading the log is Manager/owner-only (need-to-know, per the privacy
    // team's least-access note). Nothing can ever be edited or deleted, so it stays a genuine
    // record rather than something that could be quietly rewritten after the fact.
    // ---- Usage: whether the tool is being opened, per person.
    // Each person's browser writes only their own row, and only an Admin (or the owner) can
    // read them — this answers "is the team using this", and is deliberately not readable by
    // the people's own managers, which is the line the privacy note in the app describes.
    // Nothing here says what anyone looked at: day counts, a last-seen stamp, and how many
    // change notifications they have unread.
    match /usage/{memberId} {
      // A person can read their own row, and that is load-bearing, not a courtesy: the client
      // reads the row before writing it, to add to the day's count and drop the days that have
      // aged out. Without this, every write by anyone who isn't an Admin failed on the read and
      // nothing they did was ever recorded — while Admins, who could read, recorded fine.
      // It is their own data; only an Admin can read anybody else's.
      allow read: if isOwner() || isAdminUid() || isMyMemberRow(memberId);
      allow create, update: if isMyMemberRow(memberId)
        && request.resource.data.memberId == memberId
        && request.resource.data.keys().hasOnly(['memberId','lastAt','firstAt','opens','days','unread','oldestUnreadAt']);
      allow delete: if isOwner() || isAdminUid();
    }

    match /audit_log/{entryId} {
      allow create: if isApproved() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isOwner() || isManagerUid();
      allow update, delete: if false;
    }

    // ---- Ideas & Bugs tracker: anyone approved can submit and read the list (so people
    // closest to the actual work can flag what's needed), but only a Manager/owner can move
    // something's status/priority or remove it — matches how triage/prioritization is a
    // deliberate admin action everywhere else in this app.
    function isValidIdea(d){
      return d.type in ['idea','bug']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && (d.description == null || (d.description is string && d.description.size() <= 4000))
        && d.status in ['backlog','in_progress','done']
        && d.priority in ['low','medium','high'];
    }
    match /ideas_log/{ideaId} {
      allow read: if isApproved();
      allow create: if isApproved() && isValidIdea(request.resource.data)
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'backlog';
      allow update: if (isOwner() || isManagerUid()) && isValidIdea(request.resource.data);
      allow delete: if isOwner() || isManagerUid();
    }

    // ---- Notifications: schedule-change alerts for a specific person, stored as a
    // subcollection per member (notifications/{memberId}/items/{notifId}) rather than one
    // flat collection filtered by a memberId field. That matters: a flat collection would
    // need a query filtered on memberId while the read rule also depends on the caller's own
    // claimed_links — the same shape as a real bug hit earlier, where Firestore can reject a
    // multi-document query outright if its rule depends on more than the filtered field, even
    // when the one matching document would itself be perfectly readable. Scoping by path
    // instead sidesteps that: the subcollection IS the scope, so the rule doesn't need a
    // where-filter to reason about at all.
    // Same two-way check the member row uses (isMyMemberRow): this used to depend on the
    // claimed_links marker alone, so anyone whose marker was never written — the case-
    // sensitive email comparison above was one way that happened — couldn't read their own
    // notifications or mark one as read, even though the app could see perfectly well whose
    // they were.
    function isOwnNotifPath(memberId) {
      return isMyMemberRow(memberId);
    }
    match /notifications/{memberId}/items/{notifId} {
      allow read: if isOwner() || isManagerUid() || isOwnNotifPath(memberId);
      // Batched schedule-change notifications ("Send notifications") stay strictly
      // Admin/Manager — that's the whole point of requiring their confirmation before sending.
      // Instant OOO-coverage notifications are different: they can be triggered by a plain
      // Viewer marking themselves off, so any approved (signed-in, not just admin) person may
      // create one — but only that one narrow kind, never the batched kind. Worst-case misuse
      // here is a misleading informational message, not a privilege or data-access issue —
      // notifications don't grant access to anything.
      allow create: if isOwner() || isManagerUid()
        || (isApproved() && request.resource.data.kind == 'ooo_coverage');
      allow update: if (isOwner() || isManagerUid())
        || (isOwnNotifPath(memberId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isOwner() || isManagerUid();
    }
  }
}
